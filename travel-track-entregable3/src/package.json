{
  "name": "travel-track-entregable3",
  "version": "1.0.0",
  "description": "A NestJS application for tracking travel requests and employee information.",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc",
    "prestart": "npm run build",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "10.4.16",
    "@nestjs/core": "^9.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0",
    "typescript": "^4.5.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^9.0.0",
    "jest": "^27.0.0",
    "ts-jest": "^27.0.0",
    "supertest": "^6.0.0"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testRegex": ".spec.ts$",
    "moduleFileExtensions": ["ts", "js", "json", "node"],
    "coverageDirectory": "coverage"
  },
  "license": "MIT"
}